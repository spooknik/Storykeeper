# Copy this file to .env and adjust as needed.
# Used both by `docker compose` (variable substitution in docker-compose.yml)
# and, if you export them yourself, by running the binary directly.

# Address the HTTP server listens on.
# SK_ADDR=:8080

# Directory where Storykeeper stores its database and other app state.
# In the container this is fixed at /data by the compose file; change the
# ./data host path in docker-compose.yml instead of this if you need to
# relocate it on the host.
# SK_DATA_DIR=/data

# Host path to your audiobook library, mounted into the container at
# /library. Leave unset to use ./library next to this file.
# LIBRARY_PATH=./library

# Optional: initial library path inside the container to scan on first run.
# SK_LIBRARY=/library

# Bootstrap credentials for the first admin account. If unset, Storykeeper
# will prompt/generate credentials on first run instead.
# SK_ADMIN_USER=admin
# SK_ADMIN_PASSWORD=change-me

# Set to true when Storykeeper is served over HTTPS behind a reverse proxy,
# so session cookies are marked Secure. See docs/PROXY.md.
# SK_SECURE_COOKIE=false

# Set to true only when a reverse proxy you control is the sole way to reach
# Storykeeper; the login rate limiter then uses X-Forwarded-For for the client IP.
# SK_TRUST_PROXY=false
