# Environment for the Portainer stack (deploy/portainer/docker-compose.yml).
# Upload this file in Portainer with "Load variables from .env file", or copy
# each line into the stack's Environment variables panel.

# Host paths on TrueNAS. Datasets, not the root of the pool.
SK_DATA_PATH=/mnt/tank/apps/storykeeper/data
SK_LIBRARY_PATH=/mnt/tank/media/audiobooks

# First admin account, created only on the very first start.
SK_ADMIN_USER=admin
SK_ADMIN_PASSWORD=change-me-before-deploying

# Host port Nginx Proxy Manager forwards to.
SK_HTTP_PORT=8080

# Image tag. "latest" follows main; a tag like v0.1.0 pins a release.
SK_IMAGE_TAG=latest

TZ=Europe/Copenhagen
